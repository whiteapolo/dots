set_cursor_beam() {
  echo -ne '\e[5 q'
}

set_cursor_block() {
  echo -ne '\e[2 q'
}

add_path() {
  path+="$1"
}

lcdf() {
  tmp="$(mktemp)"
  lf -last-dir-path="$tmp" "$@"
  if [ -f "$tmp" ]; then
    dir="$(cat "$tmp")"
    rm -f "$tmp"
    [ -d "$dir" ] && [ "$dir" != "$(pwd)" ] && cd "$dir"
  fi
}

blue_filter() {
  temperature="${1:-2600}"
  redshift -l 32.1:34.87 -t "$temperature:$temperature" -g 0.8 -m randr -v &
}

fl() {
  [ "${NNNLVL:-0}" -eq 0 ] || {
    echo "nnn is already running"
      return
  }

  export NNN_TMPFILE="${XDG_CONFIG_HOME:-$HOME/.config}/nnn/.lastd"

  nnn -de "$@"

  [ ! -f "$NNN_TMPFILE" ] || {
    . "$NNN_TMPFILE"
      rm -f -- "$NNN_TMPFILE" > /dev/null
    }

  export NNN_FIFO=/tmp/nnn.fifo
}

