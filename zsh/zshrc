init_vi_mode() {
  bindkey -v
  export KEYTIMEOUT=1
  bindkey -v '^?' backward-delete-char

  zle-keymap-select () {
    case $KEYMAP in
      vicmd) set_cursor_block;;
      viins|main) set_cursor_beam;;
    esac
  }

  zle -N zle-keymap-select

  zle-line-init() {
    zle -K viins
  }

  preexec() {
    set_cursor_block
  }

  zle -N zle-line-init
}

