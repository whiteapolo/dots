{
	"height": 30,
	"spacing": 4,
	"modules-left": ["hyprland/workspaces"],
	"modules-center": ["hyprland/window"],
	"modules-right": ["tray", "battery", "clock"],
	"hyprland/window": {
		"tooltip": false
	},
	"battery": {
		"states": {
			"warning": 50,
			"critical": 30
		},
		"format": "{capacity}%",
		"interval": 5
	},
	"tray": {
		"spacing": 10
	},
	"clock": {
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
		"format": "<span>{:%d/%m/%Y %H:%M}</span>",
		"interval": 5
	}
}
